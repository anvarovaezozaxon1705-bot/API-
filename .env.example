# Скопируйте этот файл в .env и вставьте свои ключи.
# Модели без ключа просто не будут участвовать.

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# Необязательно: какую версию модели использовать у каждого провайдера
OPENAI_MODEL=gpt-5
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-opus-5-5
DEEPSEEK_MODEL=deepseek-chat
XAI_MODEL=grok-4

PORT=3000
# MOCK=1 — демо-режим без ключей (ответы-заглушки, чтобы посмотреть интерфейс)
MOCK=0
